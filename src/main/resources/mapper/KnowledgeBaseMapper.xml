<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentforge.mapper.KnowledgeBaseMapper">

    <resultMap id="KnowledgeBaseResult" type="com.agentforge.model.entity.KnowledgeBase">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="metadata" column="metadata"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="allColumns">
        id, name, description, metadata::text AS metadata, created_at, updated_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO knowledge_base (name, description, metadata)
        VALUES (#{name}, #{description}, CAST(#{metadata} AS jsonb))
    </insert>

    <select id="selectById" resultMap="KnowledgeBaseResult">
        SELECT <include refid="allColumns"/>
        FROM knowledge_base
        WHERE id = CAST(#{id} AS uuid)
    </select>

    <select id="selectAll" resultMap="KnowledgeBaseResult">
        SELECT <include refid="allColumns"/>
        FROM knowledge_base
        ORDER BY created_at DESC
    </select>

    <select id="selectByIdBatch" resultMap="KnowledgeBaseResult">
        SELECT <include refid="allColumns"/>
        FROM knowledge_base
        WHERE id IN
        <foreach collection="ids" item="item" open="(" separator="," close=")">
            CAST(#{item} AS uuid)
        </foreach>
    </select>

    <delete id="deleteById">
        DELETE FROM knowledge_base WHERE id = CAST(#{id} AS uuid)
    </delete>

    <update id="updateById">
        UPDATE knowledge_base
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            updated_at = NOW()
        </set>
        WHERE id = CAST(#{id} AS uuid)
    </update>
</mapper>
